{
  "name": "spectral-wave-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser port of the spectral_wave viewer: the Python algorithm runs unchanged in Pyodide, the page only renders.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:py": "node scripts/run-python.mjs scripts/build_py_archive.py",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run build:py && npm run typecheck && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
